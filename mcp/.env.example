# ---------- Database ----------
# Same Postgres + pgvector database as the Lumen Concierge app (load it there with `npm run setup`).
# On Vercel use the POOLED connection string (Neon / Supabase pooler).
DATABASE_URL=postgres://localhost:5432/lumen

# ---------- HTTP ----------
PORT=3100
# 127.0.0.1 locally; 0.0.0.0 in a container
HOST=127.0.0.1
# Bearer token for /mcp. Generate: openssl rand -hex 32   (required on Vercel)
MCP_TOKEN=
# Comma-separated Host names allowed over HTTP, e.g. mcp.example.com. Unset = localhost only (Vercel: token only).
MCP_ALLOWED_HOSTS=

# ---------- Order tools ----------
# Set to ONE customer ID to also expose get_order_status / prepare_return_request for that customer.
# Leave empty on any public deployment.
LUMEN_CUSTOMER_ID=

# ---------- Policy search ----------
# vector   = semantic search with embeddings (EMBEDDING_PROVIDER below)
# fulltext = Postgres full-text search: no model, no token (use on Vercel without Hugging Face credits)
POLICY_SEARCH=vector

# ---------- Embeddings (only for POLICY_SEARCH=vector) ----------
# local       = FastEmbed on CPU; weights (~200MB) download once and are cached
# huggingface = same model via the Hugging Face Inference API (use on Vercel); needs HF_TOKEN
EMBEDDING_PROVIDER=local
HF_TOKEN=
