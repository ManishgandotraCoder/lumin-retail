{
  "name": "lumen-concierge",
  "version": "1.0.0",
  "description": "Lumen Concierge AI - shopping & support assistant (LangGraph + LangChain, RAG on pgvector, PostgreSQL memory, LangSmith, Altrum AI gateway)",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:create": "createdb lumen && psql -d lumen -c \"CREATE EXTENSION IF NOT EXISTS vector\"",
    "seed": "tsx src/db/seed.ts",
    "ingest": "tsx src/rag/ingest.ts",
    "catalog:expand": "tsx scripts/expand-catalog.ts",
    "setup": "npm run seed && npm run ingest && npm run catalog:expand",
    "mock-gateway": "tsx scripts/mock-altrum-gateway.ts",
    "test": "tsx scripts/test-e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@langchain/anthropic": "^1.6.6",
    "@langchain/core": "^1.5.0",
    "@langchain/google-genai": "^2.3.7",
    "@langchain/langgraph": "^1.7.5",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.4",
    "@langchain/mcp-adapters": "^2.0.3",
    "@langchain/openai": "^1.8.5",
    "@langchain/pgvector": "^0.1.0",
    "@langchain/textsplitters": "^1.0.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "fastembed": "^3.0.0",
    "langchain": "^1.6.7",
    "langsmith": "^0.13.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@anush008/tokenizers-linux-arm64-gnu": "^0.6.0"
  }
}
