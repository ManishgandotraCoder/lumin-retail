# ---------- Server ----------
PORT=3000
# Simple token for the staff approval page (/staff.html). Change it.
STAFF_TOKEN=change-me-staff-token

# ---------- PostgreSQL (business data + LangGraph memory + pgvector) ----------
# Local PostgreSQL with the pgvector extension (see COMMANDS.md). No user/password
# = your macOS user via the local socket/trust auth.
DATABASE_URL=postgresql://localhost:5432/lumen

# ---------- Altrum AI Gateway ----------
# Chat and agent LLM calls go through Altrum.
# Real Altrum: put the gateway root URL here and choose the SDK adapter below.
# Local testing: run `npm run mock-gateway` and use http://localhost:4000/v1
ALTRUM_BASE_URL=https://api-dev.altrum.ai
# Server default provider/model; the chat page can override these per browser.
ALTRUM_PROVIDER=openai
ALTRUM_API_KEY=replace-with-router-key
# Used by the Support Agent
ALTRUM_SHOPPING_API_KEY=replace-with-support-agent-key
# Used by the Shopping Agent
ALTRUM_SUPPORT_API_KEY=replace-with-shopping-agent-key
# Optional model overrides, defaults depend on ALTRUM_PROVIDER.
LLM_MODEL=openai/gpt-4o-mini
# ANTHROPIC_LLM_MODEL=anthropic/claude-sonnet-4-5
# How the app reads Altrum's verdict. Confirm these against the Altrum docs
# and change them here (no code change needed).
# Response header that carries the guardrail action (allow / block / mask)
ALTRUM_ACTION_HEADER=x-altrum-action
# HTTP status codes Altrum uses when it blocks a request
ALTRUM_BLOCK_STATUS=400,403,422,451

# ---------- Models ----------
# Policy embeddings run locally on CPU; weights download once and are cached.
EMBEDDING_PROVIDER=local

# ---------- Memory ----------
# Number of recent messages the agents see from the conversation
MEMORY_LAST_MESSAGES=12
# Altrum masks data before it reaches the model, but chat memory (LangGraph checkpoint) is
# saved before the agent's gateway call, so raw card numbers etc. would be stored in Postgres.
# true  = mask PII locally first (recommended for anything beyond testing)
# false = send raw text so you can test Altrum's own masking
LOCAL_REDACT_INPUT=false

# ---------- LangSmith (tracing, monitoring, graph flow) ----------
# Create an API key at https://smith.langchain.com (Settings -> API Keys).
# Each chat turn is one trace: chat_turn -> lumen_concierge graph -> router / agent -> LLM + tools.
# PII (cards, emails, phones, IDs) is masked by the app before traces are uploaded.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lumen-concierge
# EU region: https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
